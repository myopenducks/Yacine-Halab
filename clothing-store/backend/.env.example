# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=clothing_store

# JWT — use `openssl rand -base64 48` for production (min 32 chars, no placeholders)
JWT_SECRET=replace-this-with-a-long-random-string-please
JWT_EXPIRES_IN=7d

# Seed (used by scripts/seed.ts)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGIN=*
